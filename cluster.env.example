# Copy to cluster.env (git-ignored) and edit. Sourced by scripts/remote.sh, the setup script
# and the Slurm job.
JPW_HOST=iisc_amd                    # SSH host alias from ~/.ssh/config
JPW_REMOTE_DIR=jepa-parkour-wm       # path on the cluster, relative to $HOME
JPW_VENV=$HOME/venvs/jpw             # bare-metal virtualenv (no container)
JPW_PYTHON=3.12                      # python version for uv
JPW_JAX_EXTRA=rocm60                 # pyproject extra providing jax (rocm60 = system ROCm 6.x)
JPW_MODULES=""                       # e.g. "rocm/7.0 python/3.12" if the cluster uses modules
JPW_SBATCH_ARGS=""                   # e.g. "-p gpu -A myaccount --time=12:00:00"
# WANDB_ENTITY=your-team
